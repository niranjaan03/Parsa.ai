{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|ico|woff|woff2|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-keys",
      "destination": "/index.html"
    },
    {
      "source": "/apikeys",
      "destination": "/index.html"
    },
    {
      "source": "/keys",
      "destination": "/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/ui",
      "destination": "/workspace.html"
    },
    {
      "source": "/lithos/:path*",
      "destination": "/lithos/:path*"
    },
    {
      "source": "/lithos",
      "destination": "/lithos/index.html"
    }
  ]
}
